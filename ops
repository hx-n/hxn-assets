{"author":{"id":"585844baa6074d44d241f46aa7c9f21ff46653adf617d7f070fbfe327626c989"},"ops":[{"type":2,"timestamp":1794989805,"nonce":"G44xSbUXvvHqoLG83IgsrcxLON0=","title":"Local-first CRDT assets with durable local edits and remote synchronization","was":"Add opt-in CRDT-backed assets to the metadata-authored asset system. A CRDT asset has a stable logical document ID and typed local view, supports local reads and writes while offline, and synchronizes with a configured remote replica. Normal embedded assets, dynamic downloads, saves and preferences acquire no CRDT/network dependency. Metadata names such as @:crdtAsset are provisional until the API is implemented."}]}