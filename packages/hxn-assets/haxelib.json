{
  "name": "hxn-assets",
  "version": "0.2.0",
  "license": "Apache",
  "url": "https://github.com/hx-n/hxn-assets",
  "description": "Typed assets, asynchronous loading and semantic knowledge metadata",
  "contributors": [
    "darmie"
  ],
  "releasenote": "Packaged embedded graph with selectable JIT and portable checkpoints.",
  "classPath": "src",
  "dependencies": {
    "hxn": "0.3.10",
    "hxn-file": "0.2.0",
    "format": "3.8.0"
  },
  "hxn": {
    "cli": {
      "version": 1,
      "namespace": "assets",
      "command": [
        "haxe",
        "-cp",
        "{root}/src",
        "--run",
        "hxn.assets.cli.Tool"
      ],
      "hooks": []
    }
  },
  "tags": [
    "hxcpp",
    "hashlink",
    "native",
    "cross",
    "wasm",
    "assets"
  ]
}
